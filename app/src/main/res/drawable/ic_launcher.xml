<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon: a stylised camera body with an amber lens, matching the
  in-app palette. Vector-only keeps the skeleton free of density buckets; an
  adaptive icon (mipmap-anydpi-v26) is a cosmetic follow-up.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- Body -->
    <path
        android:fillColor="#1A1D21"
        android:pathData="M8,10 h32 a4,4 0 0 1 4,4 v24 a4,4 0 0 1 -4,4 h-32 a4,4 0 0 1 -4,-4 v-24 a4,4 0 0 1 4,-4 z" />

    <!-- Top plate / viewfinder hump -->
    <path
        android:fillColor="#33383F"
        android:pathData="M16,6 h16 v6 h-16 z" />

    <!-- Lens outer -->
    <path
        android:fillColor="#F2B441"
        android:pathData="M32,26 m-11,0 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0" />

    <!-- Lens inner -->
    <path
        android:fillColor="#101214"
        android:pathData="M32,26 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Lens highlight -->
    <path
        android:fillColor="#6FCF97"
        android:pathData="M32,26 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
</vector>
