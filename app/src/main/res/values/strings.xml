<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-visible copy for YI M1 遥控 (third-party replacement for the dead
  official YI Mirrorless app). Chinese is the only shipped language: the camera
  and its users are Chinese-market and the official app was Chinese-only.

  This app releases only the camera-local capabilities (connect / live view /
  remote capture / camera settings / SD-card gallery).
-->
